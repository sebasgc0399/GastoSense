rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Auth required for all application collections
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // userId helpers
    function requestUserMatches() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }
    function resourceUserMatches() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Validate common transaction fields
    function validTransaction() {
      return request.resource.data.keys().hasAll(['amount','type','paymentMethod','date','userId'])
        && request.resource.data.amount is number
        && request.resource.data.type in ['expense','income']
        && request.resource.data.paymentMethod in ['efectivo','debito','credito','digital','otro']
        && (
          request.resource.data.type == 'income'
          || ('categoryId' in request.resource.data && request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 120)
          || ('category' in request.resource.data && request.resource.data.category is string && request.resource.data.category.size() <= 120)
        );
    }

    function validTemplate() {
      return requestUserMatches()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
        && (!('categoryId' in request.resource.data) || (request.resource.data.categoryId is string && request.resource.data.categoryId.size() <= 120))
        && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 120))
        && (!('amount' in request.resource.data) || request.resource.data.amount is number)
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('paymentMethod' in request.resource.data) || request.resource.data.paymentMethod in ['efectivo','debito','credito','digital','otro'])
        && (!('type' in request.resource.data) || request.resource.data.type in ['expense','income'])
        && (!('recurring' in request.resource.data) || request.resource.data.recurring is bool)
        && (!('frequency' in request.resource.data) || request.resource.data.frequency in ['weekly','biweekly','monthly','yearly']);
    }

    function validBudget() {
      return isSignedIn()
        && request.resource.data.keys().hasAny(['total','perCategory','month'])
        && request.resource.data.month is string
        && (!('total' in request.resource.data) || request.resource.data.total is number)
        && (!('perCategory' in request.resource.data) || request.resource.data.perCategory is map)
        && (!('perCategory' in request.resource.data) || request.resource.data.perCategory.size() <= 50)
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid);
    }

    function validObjective() {
      return requestUserMatches()
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
        && (!('type' in request.resource.data) || request.resource.data.type in ['goal','debt'])
        && (!('targetAmount' in request.resource.data) || request.resource.data.targetAmount is number)
        && (!('currentAmount' in request.resource.data) || request.resource.data.currentAmount is number)
        && (!('icon' in request.resource.data) || (request.resource.data.icon is string && request.resource.data.icon.size() <= 60))
        && (!('color' in request.resource.data) || (request.resource.data.color is string && request.resource.data.color.size() <= 20))
        && (!('dueDate' in request.resource.data) || request.resource.data.dueDate is timestamp)
        && (!('status' in request.resource.data) || request.resource.data.status in ['active','completed','archived'])
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt is timestamp);
    }

    function objectiveHasRequiredFields() {
      return request.resource.data.keys().hasAll(['userId','type','name','targetAmount','currentAmount','status','createdAt','updatedAt']);
    }

    function validObjectiveEntry() {
      return requestUserMatches()
        && (!('amount' in request.resource.data) || request.resource.data.amount is number)
        && (!('kind' in request.resource.data) || request.resource.data.kind in ['deposit','withdraw','payment'])
        && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500))
        && (!('effectiveDate' in request.resource.data) || request.resource.data.effectiveDate is timestamp)
        && (!('createdAt' in request.resource.data) || request.resource.data.createdAt is timestamp)
        && (
          !('linkedTransactionId' in request.resource.data)
          || request.resource.data.linkedTransactionId is string
          || request.resource.data.linkedTransactionId == null
        );
    }

    function objectiveEntryHasRequiredFields() {
      return request.resource.data.keys().hasAll(['userId','amount','kind','createdAt','linkedTransactionId']);
    }

    function objectiveOwned(objectiveId) {
      return isSignedIn()
        && get(/databases/$(database)/documents/objectives/$(objectiveId)).data.userId == request.auth.uid;
    }

    function validCategory() {
      return request.resource.data.keys().hasAll(['label','icon','order'])
        && request.resource.data.label is string
        && request.resource.data.label.size() <= 120
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 60
        && request.resource.data.order is number
        && (!('color' in request.resource.data) || (request.resource.data.color is string && request.resource.data.color.size() <= 12))
        && (!('isArchived' in request.resource.data) || request.resource.data.isArchived is bool)
        && (!('isSystem' in request.resource.data) || request.resource.data.isSystem is bool);
    }

    // Budgets are stored as {uid}_{month}; enforce that the caller matches the prefix
    function budgetDocOwned(docId) {
      return isSignedIn() && docId.matches('^' + request.auth.uid + '_.+');
    }

    match /transactions/{docId} {
      allow read, list: if resourceUserMatches();
      allow create: if requestUserMatches() && validTransaction();
      allow update: if requestUserMatches() && resourceUserMatches() && validTransaction();
      allow delete: if resourceUserMatches();
    }

    match /templates/{docId} {
      allow read, list: if resourceUserMatches();
      allow create: if requestUserMatches() && validTemplate();
      allow update: if requestUserMatches() && resourceUserMatches() && validTemplate();
      allow delete: if resourceUserMatches();
    }

    match /budgets/{docId} {
      allow read, list: if budgetDocOwned(docId);
      allow create: if budgetDocOwned(docId) && validBudget();
      allow update: if budgetDocOwned(docId) && validBudget();
      allow delete: if budgetDocOwned(docId);
    }

    match /objectives/{objectiveId} {
      allow read, list: if resourceUserMatches();
      allow create: if requestUserMatches() && objectiveHasRequiredFields() && validObjective();
      allow update: if requestUserMatches() && resourceUserMatches() && validObjective();
      allow delete: if resourceUserMatches();

      match /entries/{entryId} {
        allow read, list: if objectiveOwned(objectiveId);
        allow create: if objectiveOwned(objectiveId)
          && requestUserMatches()
          && objectiveEntryHasRequiredFields()
          && validObjectiveEntry();
        allow delete: if objectiveOwned(objectiveId);
      }
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();

      match /categories/{categoryId} {
        allow read, list: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid && validCategory();
        allow update: if isSignedIn() && request.auth.uid == uid && validCategory();
        allow delete: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
